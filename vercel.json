{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {"src": "package.json", "use": "@vercel/static-build", "config": {"distDir": "dist-v2"}},
    {"src": "discover-v3.js", "use": "@vercel/node"}
  ],
  "routes": [
    {"src": "/api/discover", "dest": "/discover-v3.js"},
    {"handle": "filesystem"},
    {"src": "/.*", "dest": "/index.html"}
  ],
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]}
  ]
}
