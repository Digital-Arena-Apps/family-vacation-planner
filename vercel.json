{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "nearby.js",
      "use": "@vercel/node"
    },
    {
      "src": "food.js",
      "use": "@vercel/node"
    },
    {
      "src": "discover.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "decision-demo-loader.js",
      "use": "@vercel/static"
    },
    {
      "src": ".demo-build/js1.txt",
      "use": "@vercel/static"
    },
    {
      "src": ".demo-build/js2.txt",
      "use": "@vercel/static"
    },
    {
      "src": ".demo-build/js3.txt",
      "use": "@vercel/static"
    },
    {
      "src": ".demo-build/js4.txt",
      "use": "@vercel/static"
    },
    {
      "src": ".demo-build/css1.txt",
      "use": "@vercel/static"
    },
    {
      "src": ".demo-build/css2.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.webmanifest",
      "use": "@vercel/static"
    },
    {
      "src": "icon-192.png",
      "use": "@vercel/static"
    },
    {
      "src": "icon-512.png",
      "use": "@vercel/static"
    },
    {
      "src": "brand-mark.png",
      "use": "@vercel/static"
    },
    {
      "src": "brand-logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "landing-scenic.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/nearby",
      "dest": "/nearby.js"
    },
    {
      "src": "/api/food",
      "dest": "/food.js"
    },
    {
      "src": "/api/discover",
      "dest": "/discover.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
