{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {"src": "nearby.js", "use": "@vercel/node"},
    {"src": "food.js", "use": "@vercel/node"},
    {"src": "discover.js", "use": "@vercel/node"},
    {"src": "weather.js", "use": "@vercel/node"},
    {"src": "base-search.js", "use": "@vercel/node"},
    {"src": "package.json", "use": "@vercel/static-build", "config": {"distDir": "dist"}}
  ],
  "routes": [
    {"src": "/api/nearby", "dest": "/nearby.js"},
    {"src": "/api/food", "dest": "/food.js"},
    {"src": "/api/discover", "dest": "/discover.js"},
    {"src": "/api/weather", "dest": "/weather.js"},
    {"src": "/api/base-search", "dest": "/base-search.js"},
    {"handle": "filesystem"},
    {"src": "/.*", "dest": "/index.html"}
  ],
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/manifest.webmanifest", "headers": [{"key": "Content-Type", "value": "application/manifest+json"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/decision-demo-loader.js", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/decision-demo.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/decision-demo.css", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/orlando-early-access.css", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/base-location.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/family-ui-test.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]}
  ]
}
