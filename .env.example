# Browser preview can leave this blank and use same-origin /api/discover.
# Native release builds must point at the public FERDA web/API origin, e.g.
# VITE_FERDA_API_BASE=https://app.example.com
VITE_FERDA_API_BASE=

# Optional server-side enhancement. If absent, discovery falls back to OpenStreetMap/Overpass.
GOOGLE_PLACES_API_KEY=
