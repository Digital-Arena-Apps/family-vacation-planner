{
  "name": "ferda-family-travel-planner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.v2.config.mjs",
    "build": "vite build --config vite.v2.config.mjs",
    "preview": "vite preview --config vite.v2.config.mjs",
    "native:sync": "npm run build && npx cap sync",
    "native:add:ios": "npx cap add ios",
    "native:add:android": "npx cap add android",
    "native:open:ios": "npx cap open ios",
    "native:open:android": "npx cap open android",
    "native:doctor": "npx cap doctor"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.11.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "vite": "^8.2.2"
  }
}
